# Fully static Linux x86_64 ts_analyze (musl). Usage:
#   podman build -f Containerfile -o type=local,dest=dist .
# The binary lands in dist/ts_analyze.
FROM docker.io/library/alpine:3.20 AS build
RUN apk add --no-cache build-base cmake
WORKDIR /src
COPY CMakeLists.txt ./
COPY include include
COPY src src
RUN cmake -S . -B /build -DCMAKE_BUILD_TYPE=Release -DTS_ANALYZE_STATIC=ON \
 && cmake --build /build -j4

FROM scratch
COPY --from=build /build/ts_analyze /ts_analyze
